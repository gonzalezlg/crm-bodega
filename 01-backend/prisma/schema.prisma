generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  descripcion String?
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  id            String   @id @default(uuid()) @db.Uuid
  dni           String   @unique
  nombre        String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  activo        Boolean  @default(true)
  rolId         Int      @map("rol_id")
  rol           Rol      @relation(fields: [rolId], references: [id])
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

model Cliente {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String
  apellido      String
  telefono      String
  email         String
  ubicacion     String?
  observaciones String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("clientes")
}

model Categoria {
  id            String     @id @default(uuid()) @db.Uuid
  nombre        String     @unique
  descripcion   String?
  activo        Boolean    @default(true)
  productos     Producto[]
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")

  @@map("categorias")
}

model Producto {
  id            String    @id @default(uuid()) @db.Uuid
  nombre        String
  descripcion   String?
  categoriaId   String    @map("categoria_id") @db.Uuid
  categoria     Categoria @relation(fields: [categoriaId], references: [id])
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  @@unique([nombre, categoriaId])
  @@index([categoriaId])
  @@map("productos")
}

model Experience {
  id              String     @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  durationMinutes Int        @map("duration_minutes")
  active          Boolean    @default(true)
  timeSlots       TimeSlot[]
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@map("experiences")
}

model TimeSlot {
  id           String     @id @default(uuid()) @db.Uuid
  experienceId String     @map("experience_id") @db.Uuid
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Restrict)
  weekday      Weekday
  startTime    String     @map("start_time")
  maxPeople    Int        @map("max_people")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([experienceId, weekday, startTime])
  @@index([experienceId])
  @@index([weekday])
  @@map("time_slots")
}
